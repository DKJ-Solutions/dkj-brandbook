{
  "enabledPlugins": {
    "dkj-solutions@dkj-claude-plugins": true,
    "dkj-policy@dkj-claude-plugins": true,
    "dkj-subagents-alpha@dkj-claude-plugins": true,
    "dkj-subagents-shopify@dkj-claude-plugins": false
  },
  "extraKnownMarketplaces": {
    "dkj-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "DKJ-Solutions/dkj-claude-plugins"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File *.claude*plugins*cache*dkj-policy*scripts*new-branch.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File *.claude*plugins*cache*dkj-policy*scripts*open-pr.ps1*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File *.claude*plugins*cache*dkj-policy*scripts*ship-pr.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File *.claude*plugins*cache*dkj-policy*scripts*new-branch.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File *.claude*plugins*cache*dkj-policy*scripts*open-pr.ps1*)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File *.claude*plugins*cache*dkj-policy*scripts*ship-pr.ps1*)",
      "Bash(gh repo edit --delete-branch-on-merge)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/dev-server-link.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/statusline/dkj-progress.ps1\"",
    "refreshInterval": 2
  }
}
